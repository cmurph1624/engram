{
  "name": "engram",
  "version": "2.0.0",
  "description": "Engram — consolidation & recall MCP server (SRS V2). Deterministic core: registry, FSRS scheduling, vault notes.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/migrations','dist/migrations',{recursive:true})\"",
    "start": "node dist/server.js",
    "test": "node --test --test-concurrency=1 --import tsx ./src/test/*.test.ts",
    "test:unit": "node --test --import tsx ./src/test/fsrs.test.ts ./src/test/scheduler.test.ts ./src/test/notes.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.21.2",
    "gray-matter": "^4.0.3",
    "nanoid": "^5.1.0",
    "pg": "^8.13.0",
    "ts-fsrs": "^5.4.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
