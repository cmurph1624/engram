# Copy to .env (gitignored) and adjust. Read by docker compose.

# Obsidian vault root on the host, mounted at /vault (set vault_path to /vault in config.json)
ENGRAM_VAULT_DIR=/path/to/your/vault

# config.json on the host (auth_token, database_url, ...), mounted read-only
ENGRAM_CONFIG=/path/to/engram/config.json

# Existing Docker network where Postgres answers as host `db`
ENGRAM_DB_NETWORK=postgres_default

# uid:gid that owns the vault on the host (`id -u` / `id -g`); defaults to 1000:1000
# ENGRAM_UID=1000
# ENGRAM_GID=1000
